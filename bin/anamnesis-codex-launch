#!/usr/bin/env bash
# anamnesis-codex-launch — wrapper that refreshes the OAuth access token
# from ~/.anamnesis/config.json, exports it as ANAMNESIS_ACCESS_TOKEN
# (the env var .mcp.json's `bearer_token_env_var` points at), then execs
# the real `codex`. Use this in place of `codex` when you want
# Anamnesis's MCP tools (retrieve_memories etc.) available for
# model-invoked tool calls inside Codex.
#
# The plugin's hooks (SessionStart / UserPromptSubmit / Stop) work
# regardless — they read the token from config.json directly via
# common.sh's anamnesis_ensure_token. This wrapper exists only because
# Codex's MCP client expects the token at process start, in the env,
# rather than running its own OAuth dance the way Gemini CLI does.
#
# Usage:
#   anamnesis-codex-launch            # same as `codex`
#   anamnesis-codex-launch [args...]  # forwards args to codex
#
# If you have not yet run `anamnesis-config`, this wrapper will tell
# you and exit 1 — there's nothing to refresh from until the first
# OAuth dance completes.

set -eu

ANAMNESIS_HOME="${ANAMNESIS_HOME:-$HOME/.anamnesis}"
ANAMNESIS_CONFIG="$ANAMNESIS_HOME/config.json"

if [ ! -r "$ANAMNESIS_CONFIG" ]; then
    echo "anamnesis-codex-launch: ~/.anamnesis/config.json not found." >&2
    echo "  Run 'anamnesis-config' first to complete the OAuth setup." >&2
    exit 1
fi

if ! command -v jq >/dev/null 2>&1 || ! command -v curl >/dev/null 2>&1; then
    echo "anamnesis-codex-launch: jq and curl are required." >&2
    exit 1
fi

ACCESS_TOKEN="$(jq -r '.access_token  // empty' < "$ANAMNESIS_CONFIG")"
REFRESH_TOKEN="$(jq -r '.refresh_token // empty' < "$ANAMNESIS_CONFIG")"
EXPIRES_AT="$(jq -r '.expires_at    // 0'     < "$ANAMNESIS_CONFIG")"
CLIENT_ID="$(jq -r '.client_id     // empty' < "$ANAMNESIS_CONFIG")"
SERVER_URL="$(jq -r '.server_url   // "https://anamnesis.smtry.ai"' < "$ANAMNESIS_CONFIG")"

if [ -z "$ACCESS_TOKEN" ] || [ -z "$REFRESH_TOKEN" ]; then
    # Legacy api_key install — Codex MCP client wants a Bearer, so we
    # can't help here. Hooks still work via X-Anamnesis-Key fallback.
    echo "anamnesis-codex-launch: OAuth tokens not in config.json (legacy api_key mode)." >&2
    echo "  Re-run 'anamnesis-config' to upgrade to the OAuth flow before 2026-05-20." >&2
    echo "  Launching codex without ANAMNESIS_ACCESS_TOKEN — hooks will still capture, but" >&2
    echo "  model-invoked MCP tools won't work this session." >&2
    exec codex "$@"
fi

# Refresh if <60s to expiry. Same threshold as common.sh's
# anamnesis_ensure_token — keep them in sync if either changes.
NOW="$(date -u +%s)"
THRESHOLD=$((NOW + 60))
if [ "$EXPIRES_AT" -le "$THRESHOLD" ]; then
    RESP="$(curl -sS -X POST "${SERVER_URL}/oauth/token" \
        --max-time 8 \
        -H "Content-Type: application/x-www-form-urlencoded" \
        --data-urlencode "grant_type=refresh_token" \
        --data-urlencode "refresh_token=${REFRESH_TOKEN}" \
        --data-urlencode "client_id=${CLIENT_ID}" \
        2>/dev/null)" || RESP=""

    NEW_ACCESS="$(printf '%s' "$RESP"  | jq -r '.access_token  // empty' 2>/dev/null)"
    NEW_REFRESH="$(printf '%s' "$RESP" | jq -r '.refresh_token // empty' 2>/dev/null)"
    NEW_EXPIRES_IN="$(printf '%s' "$RESP" | jq -r '.expires_in // 0' 2>/dev/null)"

    if [ -n "$NEW_ACCESS" ] && [ -n "$NEW_REFRESH" ]; then
        NEW_EXPIRES_AT="$(date -u -v+"${NEW_EXPIRES_IN}"S +"%s" 2>/dev/null \
                       || date -u -d "+${NEW_EXPIRES_IN} seconds" +"%s" 2>/dev/null \
                       || echo 0)"
        TMP="$ANAMNESIS_CONFIG.tmp.$$"
        jq --arg at "$NEW_ACCESS" --arg rt "$NEW_REFRESH" --argjson xa "${NEW_EXPIRES_AT:-0}" \
            '.access_token = $at | .refresh_token = $rt | .expires_at = $xa' \
            < "$ANAMNESIS_CONFIG" > "$TMP" \
            && chmod 600 "$TMP" \
            && mv -f "$TMP" "$ANAMNESIS_CONFIG"
        ACCESS_TOKEN="$NEW_ACCESS"
    else
        echo "anamnesis-codex-launch: refresh failed (HTTP error or revoked token)." >&2
        echo "  Continuing with stale token — Codex MCP calls may 401 mid-session." >&2
        echo "  Re-run 'anamnesis-config' if so." >&2
    fi
fi

export ANAMNESIS_ACCESS_TOKEN="$ACCESS_TOKEN"
exec codex "$@"
